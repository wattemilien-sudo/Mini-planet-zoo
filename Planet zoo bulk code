    // Economy & Chores Loop
    setInterval(() => {
        let spawnChance = Math.min(0.95, 0.2 + (state.appeal / 300)); 
        if (Math.random() < spawnChance) trySpawnVisitor();
        if (state.appeal > 150 && Math.random() < (spawnChance * 0.6)) trySpawnVisitor();
        if (state.appeal > 300 && Math.random() < (spawnChance * 0.4)) trySpawnVisitor();

        let staffActions = state.staffCount;
        while (staffActions > 0 && state.trash.length > 0) {
            scene.remove(state.trash[0].mesh);
            state.trash.shift();
            state.money += 2;
            staffActions--;
        }

        state.animals.forEach(a => {
            if (a.happiness > 0) a.happiness -= 0.5;
            if (a.health > 0 && a.isSick) a.health -= 1.0;
            if (staffActions > 0 && a.isSick) {
                a.isSick = false; a.health = Math.min(100, a.health + 40);
                staffActions--;
            } else if (Math.random() < 0.01 && !a.isSick) {
                a.isSick = true;
            }
        });

        if (Math.random() < 0.04 && state.trash.length < 10) {
            let pathTiles = [];
            for (let r=0; r<GRID_SIZE; r++) {
                for (let c=0; c<GRID_SIZE; c++) {
                    if (state.grid[r][c] === PATH) pathTiles.push({r, c});
                }
            }
            if (pathTiles.length > 0) {
                let randomTile = pathTiles[Math.floor(Math.random() * pathTiles.length)];
                if (!state.trash.some(t => t.r === randomTile.r && t.c === randomTile.c)) {
                    const pos = gridToWorld(randomTile.r, randomTile.c);
                    const sprite = createEmojiSprite('🗑️', 0.6);
                    sprite.position.set(pos.x, 0.3, pos.z);
                    scene.add(sprite);
                    state.trash.push({ r: randomTile.r, c: randomTile.c, mesh: sprite });
                }
            }
        }

        calculateAppeal();
        let wages = state.staffCount * 12;
        if (wages > 0) state.money = Math.max(0, state.money - wages / 10);

        updateHUD();
        if (animalModal.style.display === 'flex' && selectedAnimal) updateModalStats();
    }, 1000);

    // 3D Render & Visitor Movement Animation Loop
    function animate(time) {
        requestAnimationFrame(animate);

        for (let i = state.visitorEntities.length - 1; i >= 0; i--) {
            let v = state.visitorEntities[i];

            if (v.state === 'DISAPPOINTED') {
                v.timer--;
                v.mesh.position.y = Math.sin(time * 0.01) * 0.05;
                if (v.timer <= 0) {
                    scene.remove(v.mesh);
                    state.visitorEntities.splice(i, 1);
                }
                continue;
            }

            if (v.state === 'VISITING') {
                v.timer--;
                v.mesh.position.y = Math.sin(time * 0.008) * 0.05;
                if (v.timer <= 0) {
                    if (v.moodMesh) { v.mesh.remove(v.moodMesh); v.moodMesh = null; }
                    v.path = v.path.slice().reverse();
                    v.pathIndex = 0;
                    v.progress = 0;
                    v.state = 'LEAVING';
                }
                continue;
            }

            if (v.state === 'WALKING' || v.state === 'LEAVING') {
                let currNode = v.path[v.pathIndex];
                let nextNode = v.path[v.pathIndex + 1];

                if (!nextNode) {
                    if (v.state === 'LEAVING') {
                        scene.remove(v.mesh);
                        state.visitorEntities.splice(i, 1);
                        state.visitors = state.visitorEntities.filter(v => v.state !== 'DISAPPOINTED').length;
                        updateHUD();
                        continue;
                    }

                    // REACHED ATTRACTION! Start visiting timer
                    v.state = 'VISITING';
                    v.timer = 600 + Math.floor(Math.random() * 300); 

                    // Check neighbors to see what they are visiting and charge the set ticket price!
                    let spend = 5; // Default zoo donation
                    let moodEmoji = '😍';
                    let neighbors = [
                        {r: currNode.r-1, c: currNode.c}, {r: currNode.r+1, c: currNode.c},
                        {r: currNode.r, c: currNode.c-1}, {r: currNode.r, c: currNode.c+1}
                    ];

                    for (let n of neighbors) {
                        let ride = state.rides.find(r => r.r === n.r && r.c === n.c);
                        if (ride) { spend = ride.ticketPrice; moodEmoji = RIDE_DATA[ride.type].emoji; break; }
                        
                        let shop = state.shops.find(s => s.r === n.r && s.c === n.c);
                        if (shop) { spend = shop.ticketPrice; moodEmoji = SHOP_DATA[shop.type].emoji; break; }
                        
                        let animal = state.animals.find(a => a.r === n.r && a.c === n.c);
                        if (animal) { moodEmoji = animal.emoji; break; } // Animals give a $5 donation
                    }

                    state.money += spend;
                    updateHUD();

                    // Show visual feedback of what they bought/visited
                    v.moodMesh = createEmojiSprite(moodEmoji, 0.5);
                    v.moodMesh.position.y = 0.95;
                    v.mesh.add(v.moodMesh);
                    continue;
                }

                v.progress += v.speed;
                let startPos = gridToWorld(currNode.r, currNode.c);
                let endPos = gridToWorld(nextNode.r, nextNode.c);

                v.mesh.position.x = startPos.x + (endPos.x - startPos.x) * v.progress;
                v.mesh.position.z = startPos.z + (endPos.z - startPos.z) * v.progress;
                v.mesh.position.y = Math.abs(Math.sin(v.progress * Math.PI * 2)) * 0.1;

                if (v.progress >= 1.0) {
                    v.progress = 0;
                    v.pathIndex++;
                }
            }
        }
        
        state.animals.forEach((a, i) => {
            if (a.mesh) a.mesh.position.y = 0.6 + Math.sin(time * 0.003 + i) * 0.08;
        });

        state.rides.forEach(rd => {
            if (rd.mesh) rd.mesh.rotation.y += 0.01;
        });

        controls.update();
        renderer.render(scene, camera);
    }

    updateHUD();
    animate(0);

</script>
</body>
</html>
