    function calculateAppeal() {
        let speciesCounts = {};
        let total = 0;
        state.animals.forEach(a => {
            if (a.isSick) return;
            speciesCounts[a.type] = (speciesCounts[a.type] || 0) + 1;
            total += a.baseAppeal * Math.max(0.2, 1.0 - (speciesCounts[a.type] - 1) * 0.3);
        });
        state.shops.forEach(s => total += s.appeal);
        state.rides.forEach(r => total += r.appeal);
        state.appeal = Math.floor(total);
    }

